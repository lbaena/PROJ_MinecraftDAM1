<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lbaena.projecteminecraft.javafx.ViewController"
      prefWidth="600" prefHeight="750">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Ver Registros"/>

    <ListView fx:id="listView" prefWidth="500" prefHeight="500"/>

    <Button text="Volver" onAction="#goToMenu" prefWidth="150"/>

</VBox>