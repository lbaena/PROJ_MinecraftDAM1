<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750" prefWidth="600" xmlns:fx="http://javafx.com/fxml/" fx:controller="lbaena.projecteminecraft.javafx.MainMenuController">

    <ImageView fitHeight="750" fitWidth="600" preserveRatio="false">
        <image>
            <Image url="@images/img2.png" />
        </image>
    </ImageView>

    <VBox alignment="CENTER" spacing="20">

        <Button onAction="#goToCreate" prefHeight="82.0" prefWidth="150.0" text="Crear" />
        <Button onAction="#goToDelete" prefHeight="82.0" prefWidth="150.0" text="Eliminar" />
        <Button onAction="#goToView" prefHeight="82.0" prefWidth="150.0" text="Veure" />

    </VBox>

</StackPane>
